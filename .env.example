# Copy to .env and fill in before running docker-compose.prod.yml.
# .env is gitignored - never commit real values.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Do NOT use Django's get_random_secret_key() here. Its alphabet includes '$',
# and docker compose interpolates $NAME sequences when reading this file, which
# silently mangles the key (and emits "variable is not set" warnings). The
# token_urlsafe alphabet is [A-Za-z0-9_-], so it is safe as-is. If you do use a
# key containing '$', escape each one as '$$'.
DJANGO_SECRET_KEY=

# Required. Comma-separated hostnames/IPs the site is served on.
# e.g. localhost,127.0.0.1 or fe-utils.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. DEBUG, INFO, WARNING, ERROR. Defaults to INFO.
DJANGO_LOG_LEVEL=INFO

# Optional. Set to 1 only once TLS terminates at the proxy, otherwise
# SECURE_SSL_REDIRECT will redirect-loop a plain HTTP deployment.
DJANGO_SECURE_SSL=0
